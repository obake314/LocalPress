# microCMS の接続情報。このファイルをコピーして .env を作る。
#   cp .env.example .env
#
# .env は Git に入らない（.gitignore 済み）。
# ここに書いた値はビルド時にしか読まれず、配信されるJSやHTMLには含まれない。

# サービスID。管理画面のURL https://XXXX.microcms.io の XXXX の部分だけを書く
# （https:// や .microcms.io を付けて書いても自動で取り除きます）
MICROCMS_SERVICE_DOMAIN=

# 「サービス設定 > APIキー」で発行したキー。GET 権限があれば足りる
MICROCMS_API_KEY=

# ── 収集サービス（server/）を手元で動かすとき ──
# microCMS の Webhook 設定に入れる「シークレット」と同じ値。自分で決める
MICROCMS_WEBHOOK_SECRET=

# GitHub Actions から /collect を叩くための合言葉。自分で決める
#   openssl rand -hex 24
COLLECT_TOKEN=

# これより古い記事は取り込まない（日数）。0 で無制限
SKIP_OLDER_THAN_DAYS=60

